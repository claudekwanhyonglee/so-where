# Copy to .env and fill in. Never commit .env.

# Required ---------------------------------------------------------------------------------------

# The invite code. Share links carry it (?invite=...); without it nothing is accessible.
# Changing it locks out every device until they open a new link.
INVITE_CODE=change-me-to-something-long-and-random

# Server secret mixed into every stored PIN hash, so a copy of the database alone is useless.
# Generate one with: openssl rand -hex 32
# Keep it safe and don't change it: changing it invalidates every PIN (use reset-pin).
PIN_PEPPER=replace-with-output-of-openssl-rand-hex-32

# Optional (defaults shown) ----------------------------------------------------------------------

# Port the server listens on. Only for running without Docker; with Docker, change the ports mapping instead.
# PORT=3000

# Where the SQLite database lives. The Docker image sets /data/so-where.db (the volume).
# DATABASE_PATH=data/so-where.db

# Where the built frontend is served from.
# WEB_ROOT=dist/web

# How many sessions are kept. Starting a new one deletes the oldest beyond this (rankings are unaffected).
# MAX_SESSIONS=20
